# Python
__pycache__/
*.pyc
.venv/
venv/

# Env / secrets
.env
*.key

# Data (büyük/binary dosyalar commit edilmeyecek)
data/raw/*
data/processed/*
data/indexes/*
data/chunks/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/indexes/.gitkeep
!data/chunks/.gitkeep

# IDE
.vscode/*
!.vscode/settings.json

# Build artifacts (mevcut deneme dosyaları)
*.exe
*.obj
